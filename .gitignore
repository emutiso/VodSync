# Public repository allowlist: ignore everything unless explicitly approved below.
# This default-deny policy covers local development state, agent files, plans,
# diagnostics, credentials, generated output, recordings, and private fixtures.
*

# Public root files
!/.gitignore
!/LICENSE
!/NOTICE
!/README.md
!/THIRD_PARTY_NOTICES
!/index.html
!/package-lock.json
!/package.json
!/tsconfig.json
!/vite.config.ts

